# Copy to server/.env (ignored by Git) and uncomment only what you need.
# The platform reads this file on startup without any extra dependency.
# Never commit real secrets.

# PORT=8788
# MIRBAH_BIND_HOST=127.0.0.1

# Optional owner bootstrap (only used when no owner exists yet).
# If MIRBAH_OWNER_PASSWORD is omitted, a strong random password is generated
# and written to server/data/owner-credentials.txt (ignored by Git).
# MIRBAH_OWNER_EMAIL=owner@mirbah.local
# MIRBAH_OWNER_PASSWORD=

# HTTPS / production hardening
# NODE_ENV=production
# MIRBAH_PUBLIC_ORIGIN=https://mirbah.example.com
# MIRBAH_SECURE_COOKIE=1

# Only behind a trusted reverse proxy that overwrites X-Forwarded-For:
# MIRBAH_TRUST_PROXY=1

# Allow cross-origin reads of /api/public/* and /api/health only:
# MIRBAH_CORS_ORIGINS=https://example.com,https://www.example.com
