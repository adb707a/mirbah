# Environment / secrets
.env
.env.*
!.env.example
server/.env

# Sensitive material — never commit
*.key
*.pem
*.crt
*.p12
*.pfx
secrets.json
*.local.json
server/data/owner-credentials.txt

# Database & runtime data
server/data/*.db
server/data/*.db-shm
server/data/*.db-wal
server/data/backups/

# Logs / temp
*.log
*.err
*.tmp

# Dependencies (if any are ever added)
node_modules
